{
  "name": "dfir-range",
  "version": "1.0.0",
  "description": "Free, browser-based practice range for SOC and incident response interviews. Synthetic, inert evidence; randomized per seed.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
